# Python 缓存
__pycache__/
*.py[cod]
*.class

# 虚拟环境 (防止把几百兆的库传上去)
xph_env/
env/
venv/
.env

# IDE 配置
.idea/
.vscode/



# 忽略所有的 .pth 和 .pt 模型文件
*.pth
*.pt

# 忽略 checkpoints 文件夹下的所有内容（如果你不希望任何 checkpoints 被提交）
checkpoints/

# 实验运行日志和远端启动脚本输出
# 默认忽略大日志/临时结果；只允许精选的小型证据包入库。
logs/*
!logs/.gitkeep
!logs/ae_case09_a95c3c4_standard/
!logs/ae_case09_a95c3c4_standard/**
!logs/suffnec09_ba2d5c8_a_support_evidence.log
!logs/suffnec09_ba2d5c8_a_sufficiency_controls.log
!logs/suffnec09_ba2d5c8_a_sufficiency_plot.log
server_logs/
results/*
!results/.gitkeep
!results/ae_case09_a95c3c4_standard/
!results/ae_case09_a95c3c4_standard/**
!results/suffnec09_ba2d5c8/
!results/suffnec09_ba2d5c8/**
.claude/

# EduData 下载缓存只作为可复现来源，不提交原始副本
data/_edudata_raw/

# Public benchmark raw archives/cache. Processed CSVs and manifests live under
# data/<dataset>/ and can be reviewed separately.
data/_public_raw/

# Generated public benchmark CSVs can be very large; keep only manifests in git.
data/frcsub/*.csv
data/math2/*.csv
data/assist_12/*.csv
data/assist_15/*.csv
data/nips34/*.csv
data/ednet_kt1/*.csv
data/assist_12_clean15_item50/*.csv
data/ednet_kt1_clean15_sample5000/*.csv
data/nips34_l3/*.csv
data/public_benchmarks_processed_*.tar.gz
