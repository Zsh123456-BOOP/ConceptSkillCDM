# Python 缓存
__pycache__/
*.py[cod]
*.class
.DS_Store

# 虚拟环境 (防止把几百兆的库传上去)
xph_env/
env/
venv/
.venv/
.env
.local_tools/

# IDE 配置
.idea/
.vscode/



# 忽略所有的 .pth 和 .pt 模型文件
*.pth
*.pt

# 忽略 checkpoints 文件夹下的所有内容（如果你不希望任何 checkpoints 被提交）
checkpoints/

# 实验运行日志和远端启动脚本输出
# 默认忽略大日志/临时结果；只允许精选的小型证据包入库。
logs/*
server_logs/
results/*
.claude/

# EduData 下载缓存只作为可复现来源，不提交原始副本
data/_edudata_raw/
data/*_coldconcept/

# Public benchmark raw archives/cache. Processed CSVs and manifests live under
# data/<dataset>/ and can be reviewed separately.
data/_public_raw/

# Generated public benchmark CSVs can be very large; keep only manifests in git.
data/frcsub/*.csv
data/math2/*.csv
data/assist_12/*.csv
data/assist_15/*.csv
data/nips34/*.csv
data/ednet_kt1/*.csv
data/assist_12_clean15_item50/*.csv
data/ednet_kt1_clean15_sample5000/*.csv
data/nips34_l3/*.csv
data/public_benchmarks_processed_*.tar.gz

# LaTeX / paper build intermediates and local preview artifacts
*.aux
*.bbl
*.log
*.blg
*.out
*.toc
*.fls
*.fdb_latexmk
docs/paper_review_2025_2026/**/*.zip
docs/paper_review_2025_2026/**/_pdf_preview/
docs/paper_review_2025_2026/**/preview_cn/
docs/paper_review_2025_2026/**/preview_en/
docs/paper_review_2025_2026/**/preview_pdf_check/
